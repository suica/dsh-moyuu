{
  "name": "dsh-moyuu-session-write-lock",
  "version": "0.1.0",
  "description": "Feature: cross-process session write-lock persistence backend — subclass of the JSONL session-persistence backend that serializes concurrent writers across profiles so shared sessions are never corrupted.",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "session",
    "persistence",
    "lock"
  ],
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-session-persistence-jsonl": "*",
    "@deepseek-ai/dsh-session": "*"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-session": "0.1.0-rc.6",
    "@deepseek-ai/dsh-session-persistence-jsonl": "0.1.0-rc.6"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "license": "MIT"
}
